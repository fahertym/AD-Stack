# Domain Configuration
AD_DOMAIN={{ ad_domain }}
AD_REALM={{ ad_realm }}
AD_ADMIN_PASSWORD={{ ad_admin_password }}

# Network Configuration  
AD_SERVER_IP={{ ad_server_ip }}
AD_DNS_FORWARDERS={{ ad_dns_forwarders | join(',') }}

# Database Configuration
POSTGRES_PASSWORD={{ postgres_password | default(lookup('password', '/dev/null chars=ascii_letters,digits length=32')) }}
REDIS_PASSWORD={{ redis_password | default(lookup('password', '/dev/null chars=ascii_letters,digits length=32')) }}

# Security Configuration
JWT_SECRET={{ jwt_secret | default(lookup('password', '/dev/null chars=ascii_letters,digits length=64')) }}
ENCRYPTION_KEY={{ encryption_key | default(lookup('password', '/dev/null chars=ascii_letters,digits length=32')) }}

# Service Configuration
AD_STACK_VERSION={{ ad_stack_version }}
DEPLOYMENT_MODE={{ deployment_mode | default('production') }}

# Storage Configuration
AD_STACK_DATA_DIR={{ ad_stack_data_dir }}
AD_STACK_LOG_DIR={{ ad_stack_log_dir }}

# Monitoring
PROMETHEUS_ENABLED={{ monitoring_enabled | default(true) }}
GRAFANA_ENABLED={{ monitoring_enabled | default(true) }}

# Backup Configuration
BACKUP_ENABLED={{ backup_enabled | default(true) }}
BACKUP_SCHEDULE={{ backup_schedule | default('0 2 * * *') }}
BACKUP_RETENTION_DAYS={{ backup_retention_days | default(30) }}